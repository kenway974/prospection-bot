# Copier ce fichier en .env puis remplir. NE JAMAIS COMMITER le .env.
# Manuel complet : MANUEL.md

# === CLÉS API ===
# Obligatoire : Google Places (console.cloud.google.com → activer « Places API »)
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
# Optionnel : sync CRM Notion (notion.so/my-integrations, partager la base avec l'intégration)
NOTION_API_KEY=
# Optionnel : SMS (app.brevo.com/settings/keys/api)
BREVO_API_KEY=
# Optionnel, lus par l'interface uniquement : envoi des mails via Gmail
# Mot de passe d'APPLICATION : myaccount.google.com/apppasswords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# === CRITÈRES DE RECHERCHE ===
# Mots-clés séparés par des virgules
SEARCH_KEYWORDS=restaurant,boulangerie,agence immobilière,garage automobile,cabinet dentaire
# Ville / zone géographique
SEARCH_LOCATION=Lyon, France
# Rayon de recherche en mètres (max 50000)
SEARCH_RADIUS=10000
# Nombre max de prospects à traiter par mot-clé (1 appel Google payant par prospect)
MAX_RESULTS_PER_KEYWORD=5

# === QUALIFICATION ===
# Note Google minimale (un prospect sans note n'est pas exclu)
MIN_RATING=3.0
# On ne contacte que les prospects dont le score est <= ce seuil (0 = pire site, 100 = parfait)
CONTACT_SCORE_THRESHOLD=70
# Sites analysés en parallèle
ANALYSIS_WORKERS=5
# Jours sans réponse avant de proposer une relance
FOLLOWUP_DELAY_DAYS=5

# === CONFIGURATION PROSPECTEUR ===
# Votre prénom (pour la signature des mails)
YOUR_NAME=Kenny
# Votre titre
YOUR_TITLE=Développeur Web Freelance
# Votre email de contact (c'est aussi l'adresse qui reçoit les « STOP »)
YOUR_EMAIL=kenny@example.com
# Votre site web (optionnel)
YOUR_WEBSITE=https://kennydev.fr

# === TEXTES (optionnels, laisser vide pour les textes par défaut) ===
# Accroche du mail ({name} = nom du prospect). L'interface la remplit avec le profil choisi.
EMAIL_HOOK=
# Texte du SMS (tronqué à 160 caractères)
SMS_HOOK=
# Phrase d'offre ajoutée à la fin du mail
YOUR_OFFER=
# Mention STOP + origine de l'adresse en bas des mails (texte par défaut si vide)
UNSUBSCRIBE_TEXT=
