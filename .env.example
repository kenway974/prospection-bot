# === GOOGLE PLACES API ===
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# === CRITÈRES DE RECHERCHE ===
# Mots-clés séparés par des virgules
SEARCH_KEYWORDS=restaurant,boulangerie,agence immobilière,garage automobile,cabinet dentaire
# Ville / zone géographique — plusieurs villes possibles, séparées par des « ; »
#   ex : SEARCH_LOCATION=Lyon, France;Villeurbanne, France
SEARCH_LOCATION=Lyon, France
# Rayon de recherche en mètres (max 50000)
SEARCH_RADIUS=10000
# Nombre max de prospects à traiter par mot-clé
MAX_RESULTS_PER_KEYWORD=5

# === CRITÈRES DE SÉLECTION (ligne de commande ; dans l'UI : « 🎯 Critères de sélection ») ===
# Fourchette de note Google
MIN_RATING=3.0
MAX_RATING=5.0
# Fourchette du nombre d'avis Google (MAX_REVIEWS vide → pas de limite)
MIN_REVIEWS=0
MAX_REVIEWS=
# Site web : any / without (sans site uniquement) / with (avec site uniquement)
WEBSITE_FILTER=any
# Téléphone : any / required / mobile (06/07 uniquement)
PHONE_FILTER=any
# Exclure les établissements fermés (temporairement ou définitivement)
EXCLUDE_CLOSED=true
# Ne garder que les prospects dont l'email a été trouvé sur le site
REQUIRE_EMAIL=false

# === CONFIGURATION PROSPECTEUR ===
# Votre prénom (pour la signature des mails)
YOUR_NAME=Kenny
# Votre titre
YOUR_TITLE=Développeur Web Freelance
# Votre email de contact
YOUR_EMAIL=kenny@example.com
# Votre site web (optionnel)
YOUR_WEBSITE=https://kennydev.fr
